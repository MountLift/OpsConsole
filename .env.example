# Copy this file to .env and fill in your own values.
# Local Postgres, or a free hosted instance from Neon (neon.tech) / Supabase (supabase.com).
#
# For Supabase specifically:
# DATABASE_URL should use the Transaction pooler (port 6543, pgbouncer=true) — this is what your app uses at runtime.
# DIRECT_URL should use the true Direct connection (db.[project-ref].supabase.co, port 5432, no pooler) — this is what Prisma uses for migrations/db push, and avoids prepared-statement conflicts that happen when migrations run through Supavisor.
DATABASE_URL="postgresql://user:password@localhost:5432/mountlift?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/mountlift?schema=public"
